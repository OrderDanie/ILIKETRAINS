class_name Gunsmith
extends RefCounted
## Procedural weapon models. Model space: origin at the web of the firing hand,
## barrel along -Z, up +Y. Moving parts are separate nodes returned in "parts".

const MK := Color(0.62, 0.63, 0.66)

static func rail(mb: Kit, c: Vector3, length: float, mat: String = "gun_blk", up: float = 1.0) -> void:
	mb.box(mat, c, Vector3(0.021, 0.005, length))
	var n: int = int(length / 0.01)
	for i in n:
		if i % 2 == 0:
			mb.box(mat, c + Vector3(0, 0.0045 * up, -length * 0.5 + 0.005 + float(i) * 0.01), Vector3(0.021, 0.004, 0.0055))

static func screw(mb: Kit, p: Vector3, axis: int = 0, r: float = 0.0032) -> void:
	mb.cyl("gun_worn", p, r, 0.0026, axis, 6)

static func ribs(mb: Kit, mat: String, c: Vector3, size: Vector3, n: int, step: Vector3) -> void:
	for i in n:
		mb.box(mat, c + step * (float(i) - float(n - 1) * 0.5), size)

static func tube(mb: Kit, mat: String, c: Vector3, r: float, length: float, seg: int = 10, th: float = 0.003) -> void:
	var w: float = 2.0 * r * tan(PI / float(seg)) + 0.0012
	for i in seg:
		var b := Basis(Vector3.BACK, TAU * float(i) / float(seg))
		mb.box(mat, c + b * Vector3(0, r, 0), Vector3(w, th, length), b)

static func grip(mb: Kit, mat: String, w: float = 0.03, h: float = 0.1, d: float = 0.046, rake: float = -0.22) -> void:
	var b := Basis(Vector3.RIGHT, rake)
	var c: Vector3 = Vector3(0, -0.006, 0.012) + b * Vector3(0, -h * 0.5, 0)
	mb.box(mat, c, Vector3(w, h, d), b)
	for sgn: float in [-1.0, 1.0]:
		mb.box("gun_grip", c + Vector3(sgn * w * 0.5, 0, 0), Vector3(0.003, h * 0.72, d * 0.74), b)
	for i in 5:
		mb.box("gun_grip", c + b * Vector3(0, -h * 0.3 + float(i) * h * 0.15, -d * 0.5), Vector3(w * 0.8, 0.006, 0.003), b)
		mb.box("gun_grip", c + b * Vector3(0, -h * 0.3 + float(i) * h * 0.15, d * 0.5), Vector3(w * 0.8, 0.006, 0.003), b)
	mb.box(mat, c + b * Vector3(0, -h * 0.5 - 0.003, 0), Vector3(w + 0.004, 0.008, d + 0.004), b)

static func trigger(mb: Kit, mat: String, z: float = -0.03, y: float = -0.012) -> void:
	mb.box(mat, Vector3(0, y - 0.03, z - 0.004), Vector3(0.011, 0.004, 0.062))
	mb.box(mat, Vector3(0, y - 0.014, z - 0.035), Vector3(0.011, 0.034, 0.004), Basis(Vector3.RIGHT, 0.25))
	mb.box("gun_worn", Vector3(0, y - 0.012, z), Vector3(0.006, 0.024, 0.006), Basis(Vector3.RIGHT, -0.3))

static func reddot(mb: Kit, c: Vector3) -> void:
	mb.box("gun_blk", c + Vector3(0, 0.007, 0), Vector3(0.026, 0.012, 0.04))
	tube(mb, "gun_blk", c + Vector3(0, 0.03, 0), 0.016, 0.052, 10, 0.003)
	mb.box("gun_glass", c + Vector3(0, 0.03, 0.02), Vector3(0.03, 0.03, 0.0008))
	mb.box("gun_dot", c + Vector3(0, 0.03, 0.019), Vector3(0.0016, 0.0016, 0.0006))
	mb.cyl("gun_blk", c + Vector3(0.021, 0.03, 0), 0.006, 0.01, 0, 8)
	mb.cyl("gun_blk", c + Vector3(0, 0.051, 0), 0.006, 0.008, 1, 8)
	screw(mb, c + Vector3(0.0135, 0.007, 0.01))
	screw(mb, c + Vector3(0.0135, 0.007, -0.01))

static func holo(mb: Kit, c: Vector3) -> void:
	mb.box("gun_blk", c + Vector3(0, 0.008, 0), Vector3(0.03, 0.014, 0.07))
	for sgn: float in [-1.0, 1.0]:
		mb.box("gun_blk", c + Vector3(sgn * 0.0165, 0.034, -0.012), Vector3(0.003, 0.04, 0.03))
		screw(mb, c + Vector3(sgn * 0.0182, 0.008, 0.02))
	mb.box("gun_blk", c + Vector3(0, 0.0555, -0.012), Vector3(0.036, 0.003, 0.03))
	mb.box("gun_glass", c + Vector3(0, 0.034, -0.012), Vector3(0.03, 0.038, 0.0008))
	mb.box("gun_dot", c + Vector3(0, 0.034, -0.0126), Vector3(0.0016, 0.0016, 0.0006))
	for i in 4:
		var b := Basis(Vector3.BACK, float(i) * PI * 0.5)
		mb.box("gun_dot", c + Vector3(0, 0.034, -0.0126) + b * Vector3(0, 0.008, 0), Vector3(0.001, 0.004, 0.0006), b)
	mb.box("gun_poly", c + Vector3(0, 0.02, 0.027), Vector3(0.026, 0.012, 0.012))

static func scope(mb: Kit, c: Vector3, length: float, r: float, r_obj: float, shade: float = 0.0) -> void:
	mb.cyl("gun_blk", c, r, length, 2, 12)
	mb.cyl("gun_blk", c + Vector3(0, 0, -length * 0.5 - 0.035), r_obj, 0.07, 2, 14)
	mb.cyl("gun_blk", c + Vector3(0, 0, -length * 0.5 + 0.012), r_obj, 0.03, 2, 12, r)
	mb.cyl("gun_lens", c + Vector3(0, 0, -length * 0.5 - 0.0705), r_obj - 0.003, 0.001, 2, 14)
	if shade > 0.0:
		tube(mb, "gun_blk", c + Vector3(0, 0, -length * 0.5 - 0.07 - shade * 0.5), r_obj, shade, 12, 0.002)
	mb.cyl("gun_blk", c + Vector3(0, 0, length * 0.5 + 0.02), r + 0.006, 0.05, 2, 12)
	mb.cyl("gun_rubber", c + Vector3(0, 0, length * 0.5 + 0.05), r + 0.007, 0.012, 2, 12)
	mb.cyl("gun_lens", c + Vector3(0, 0, length * 0.5 + 0.0565), r + 0.002, 0.001, 2, 12)
	mb.cyl("gun_blk", c + Vector3(0, r + 0.012, -0.01), 0.011, 0.024, 1, 10)
	mb.cyl("gun_worn", c + Vector3(0, r + 0.025, -0.01), 0.0115, 0.003, 1, 10)
	mb.cyl("gun_blk", c + Vector3(r + 0.012, 0, -0.01), 0.011, 0.024, 0, 10)
	mb.cyl("gun_blk", c + Vector3(-r - 0.01, 0, -0.01), 0.013, 0.02, 0, 10)
	mb.cyl("gun_blk", c + Vector3(0, 0, length * 0.5 - 0.02), r + 0.004, 0.022, 2, 12)
	for z: float in [-0.06, 0.05]:
		mb.box("gun_blk", c + Vector3(0, -r * 0.5 - 0.008, z), Vector3(0.024, r + 0.022, 0.016))
		mb.box("gun_blk", c + Vector3(0, r + 0.003, z), Vector3(0.03, 0.006, 0.016))
		screw(mb, c + Vector3(0.0125, -r - 0.012, z))

static func part(root: Node3D, pos: Vector3) -> Node3D:
	var n := Node3D.new()
	n.position = pos
	root.add_child(n)
	n.set_meta("base", pos)
	return n

static func mark(parent: Node3D, pos: Vector3, txt: String, left: bool, fsize: int = 26) -> void:
	Kit.text3d(parent, pos, txt, fsize, MK, -PI * 0.5 if left else PI * 0.5, 0.0004)

static func build(id: String) -> Dictionary:
	var root := Node3D.new()
	var mb := Kit.new()
	var o: Dictionary = {"node": root, "parts": {}, "magdir": Vector3(0, -1, 0), "bolt_travel": Vector3(0, 0, 0.05), "eject": Vector3(0.02, 0.05, -0.05), "lh": Vector3(0, 0, -0.25), "lstyle": "under", "mag": Vector3(0, -0.06, -0.09), "boltpos": Vector3(0, 0.06, 0.03), "coils": []}
	# every part is built with chamfered edges: machined steel and moulded polymer, not slabs
	var kb: Array = Kit.bevel_push(0.0034, 0.009, 1000000.0)
	match id:
		"p9": _p9(root, mb, o)
		"kestrel": _kestrel(root, mb, o)
		"stryk": _stryk(root, mb, o)
		"tundra": _tundra(root, mb, o)
		"harrow": _harrow(root, mb, o)
		"morrow": _morrow(root, mb, o)
		"sable": _sable(root, mb, o)
		"northwind": _northwind(root, mb, o)
		"bastion": _bastion(root, mb, o)
		"arclight": _arclight(root, mb, o)
		"vesper": _vesper(root, mb, o)
		"grendel": _grendel(root, mb, o)
		"halberd": _halberd(root, mb, o)
		"riveter": _riveter(root, mb, o)
	mb.commit(root, false)
	Kit.bevel_pop(kb)
	return o

# ---------------------------------------------------------------- pistols
static func _p9(root: Node3D, mb: Kit, o: Dictionary) -> void:
	grip(mb, "gun_poly", 0.03, 0.1, 0.046, -0.2)
	mb.box("gun_poly", Vector3(0, 0.008, -0.05), Vector3(0.027, 0.02, 0.17))
	mb.box("gun_poly", Vector3(0, 0.008, 0.04), Vector3(0.022, 0.012, 0.02))
	trigger(mb, "gun_poly")
	rail(mb, Vector3(0, -0.0045, -0.105), 0.05, "gun_poly", -1.0)
	mb.box("gun_blk", Vector3(0, -0.022, -0.108), Vector3(0.024, 0.022, 0.05))
	mb.cyl("gun_lens", Vector3(0, -0.022, -0.134), 0.009, 0.002, 2, 10)
	mb.box("gun_worn", Vector3(0.0125, -0.022, -0.09), Vector3(0.002, 0.008, 0.01))
	mb.cyl("gun_steel", Vector3(0, 0.036, -0.105), 0.0062, 0.1, 2, 10)
	mb.cyl("gun_blk", Vector3(0, 0.036, -0.1555), 0.0042, 0.001, 2, 8)
	mb.cyl("gun_steel", Vector3(0, 0.02, -0.132), 0.004, 0.012, 2, 8)
	mb.box("gun_steel", Vector3(-0.0145, 0.014, -0.02), Vector3(0.003, 0.006, 0.03))
	mb.box("gun_steel", Vector3(-0.0155, 0.002, 0.004), Vector3(0.004, 0.008, 0.008))
	for sgn: float in [-1.0, 1.0]:
		screw(mb, Vector3(sgn * 0.0142, 0.006, -0.05))
		screw(mb, Vector3(sgn * 0.0158, -0.085, 0.036))
	var sl: Node3D = part(root, Vector3(0, 0.036, 0))
	var sb := Kit.new()
	sb.box("gun_blk", Vector3(0, 0, -0.048), Vector3(0.0275, 0.032, 0.186))
	sb.box("gun_blk", Vector3(0, 0.0175, -0.048), Vector3(0.019, 0.003, 0.186))
	for sgn: float in [-1.0, 1.0]:
		ribs(sb, "gun_worn", Vector3(sgn * 0.0141, 0.0, 0.022), Vector3(0.0012, 0.026, 0.003), 7, Vector3(0, 0, 0.006))
		ribs(sb, "gun_worn", Vector3(sgn * 0.0141, 0.0, -0.118), Vector3(0.0012, 0.026, 0.003), 4, Vector3(0, 0, 0.006))
		sb.box("gun_blk", Vector3(sgn * 0.007, 0.022, 0.038), Vector3(0.006, 0.008, 0.008))
		sb.box("gun_trit", Vector3(sgn * 0.007, 0.0235, 0.0424), Vector3(0.0022, 0.0022, 0.001))
	sb.box("gun_steel", Vector3(0.0085, 0.012, -0.035), Vector3(0.012, 0.0115, 0.036))
	sb.box("gun_blk", Vector3(0, 0.022, -0.132), Vector3(0.004, 0.008, 0.006))
	sb.box("gun_trit", Vector3(0, 0.0235, -0.1286), Vector3(0.0022, 0.0022, 0.001))
	sb.commit(sl, false)
	mark(sl, Vector3(-0.0142, 0.003, -0.06), "VARG  P9", true, 30)
	mark(sl, Vector3(0.0142, 0.003, -0.085), "9x19   VA 31077", false, 20)
	var mg: Node3D = part(root, Vector3(0, -0.012, 0.014))
	mg.rotation.x = -0.2
	var mk := Kit.new()
	mk.box("gun_steel", Vector3(0, -0.05, 0), Vector3(0.021, 0.1, 0.033))
	mk.box("gun_poly", Vector3(0, -0.106, 0.002), Vector3(0.031, 0.011, 0.05))
	mk.cyl("gun_brass", Vector3(0, -0.002, -0.004), 0.0048, 0.024, 2, 8)
	mk.commit(mg, false)
	o["parts"] = {"bolt": sl, "mag": mg}
	o["magdir"] = Basis(Vector3.RIGHT, -0.2) * Vector3(0, -1, 0)
	o["bolt_travel"] = Vector3(0, 0, 0.036)
	o["muzzle"] = Vector3(0, 0.036, -0.158)
	o["sight"] = Vector3(0, 0.0618, 0)
	o["eject"] = Vector3(0.016, 0.05, -0.035)
	o["lh"] = Vector3(-0.012, -0.06, -0.012)
	o["lstyle"] = "cup"
	o["mag"] = Vector3(-0.005, -0.11, 0.03)
	o["boltpos"] = Vector3(-0.005, 0.045, 0.03)

static func _kestrel(root: Node3D, mb: Kit, o: Dictionary) -> void:
	var b := Basis(Vector3.RIGHT, -0.3)
	mb.box("gun_wood", Vector3(0, -0.05, 0.024), Vector3(0.032, 0.095, 0.044), b)
	mb.box("gun_wood", Vector3(0, -0.098, 0.042), Vector3(0.035, 0.028, 0.052), b)
	mb.box("gun_steel", Vector3(0, -0.045, 0.045), Vector3(0.012, 0.11, 0.008), b)
	for sgn: float in [-1.0, 1.0]:
		screw(mb, Vector3(sgn * 0.0165, -0.045, 0.024), 0, 0.0045)
		ribs(mb, "gun_grip", Vector3(sgn * 0.0162, -0.075, 0.034), Vector3(0.002, 0.004, 0.03), 4, Vector3(0, 0.009, 0.0027))
	mb.box("gun_steel", Vector3(0, 0.02, -0.002), Vector3(0.02, 0.052, 0.05))
	mb.box("gun_steel", Vector3(0, 0.052, -0.04), Vector3(0.016, 0.008, 0.12))
	mb.box("gun_steel", Vector3(0, -0.001, -0.045), Vector3(0.018, 0.012, 0.08))
	mb.box("gun_steel", Vector3(0, 0.026, -0.092), Vector3(0.022, 0.062, 0.02))
	trigger(mb, "gun_steel", -0.022, 0.004)
	mb.cyl("gun_steel", Vector3(0, 0.036, -0.172), 0.0095, 0.15, 2, 12)
	mb.box("gun_steel", Vector3(0, 0.02, -0.172), Vector3(0.014, 0.02, 0.15))
	mb.box("gun_steel", Vector3(0, 0.0495, -0.172), Vector3(0.008, 0.006, 0.15))
	ribs(mb, "gun_blk", Vector3(0, 0.0455, -0.172), Vector3(0.0086, 0.003, 0.012), 6, Vector3(0, 0, 0.022))
	mb.cyl("gun_steel", Vector3(0, 0.014, -0.11), 0.0045, 0.03, 2, 8)
	mb.box("gun_steel", Vector3(0, 0.058, -0.238), Vector3(0.004, 0.012, 0.016))
	mb.box("gun_shell", Vector3(0, 0.0625, -0.231), Vector3(0.0044, 0.004, 0.005))
	mb.box("gun_blk", Vector3(0, 0.059, 0.014), Vector3(0.016, 0.009, 0.012))
	mb.box("gun_steel", Vector3(0, 0.0615, 0.014), Vector3(0.004, 0.006, 0.014))
	mb.cyl("gun_blk", Vector3(0, 0.036, -0.2475), 0.0062, 0.001, 2, 10)
	mb.box("gun_steel", Vector3(-0.0115, 0.026, 0.008), Vector3(0.003, 0.012, 0.016))
	for sgn: float in [-1.0, 1.0]:
		screw(mb, Vector3(sgn * 0.0102, 0.006, -0.02))
		screw(mb, Vector3(sgn * 0.0102, 0.03, 0.012))
	mark(root, Vector3(-0.0098, 0.036, -0.17), "KESTREL  .44 MAGNUM", true, 20)
	mark(root, Vector3(0.0098, 0.036, -0.17), "KA 0926", false, 20)
	var hm: Node3D = part(root, Vector3(0, 0.03, 0.024))
	var hk := Kit.new()
	hk.box("gun_steel", Vector3(0, 0.014, 0.003), Vector3(0.008, 0.03, 0.01))
	hk.box("gun_worn", Vector3(0, 0.03, 0.012), Vector3(0.012, 0.004, 0.016))
	hk.commit(hm, false)
	var cr: Node3D = part(root, Vector3(-0.01, 0.004, -0.045))
	var ck := Kit.new()
	ck.box("gun_steel", Vector3(0.005, 0.011, -0.03), Vector3(0.006, 0.026, 0.012))
	ck.commit(cr, false)
	var sp: Node3D = part(cr, Vector3(0.01, 0.022, 0))
	var sk := Kit.new()
	sk.cyl("gun_steel", Vector3.ZERO, 0.0215, 0.046, 2, 12)
	for i in 6:
		var rb := Basis(Vector3.BACK, float(i) * TAU / 6.0)
		sk.box("gun_blk", rb * Vector3(0, 0.0212, -0.004), Vector3(0.009, 0.002, 0.03), rb)
		sk.cyl("gun_brass", rb * Vector3(0, 0.0125, 0.0236), 0.0052, 0.0016, 2, 8)
		sk.cyl("gun_blk", rb * Vector3(0, 0.0125, -0.0236), 0.0046, 0.0012, 2, 8)
	sk.cyl("gun_worn", Vector3(0, 0, 0.0245), 0.004, 0.004, 2, 6)
	sk.commit(sp, false)
	o["parts"] = {"cyl": cr, "spin": sp, "hammer": hm}
	o["muzzle"] = Vector3(0, 0.036, -0.25)
	o["sight"] = Vector3(0, 0.0655, 0)
	o["eject"] = Vector3(-0.03, 0.02, 0.0)
	o["lh"] = Vector3(-0.012, -0.06, -0.012)
	o["lstyle"] = "cup"
	o["mag"] = Vector3(-0.035, 0.02, -0.045)
	o["boltpos"] = Vector3(-0.005, 0.05, 0.03)

# ---------------------------------------------------------------- SMG
static func _stryk(root: Node3D, mb: Kit, o: Dictionary) -> void:
	grip(mb, "gun_tan", 0.03, 0.095, 0.044, -0.25)
	trigger(mb, "gun_tan")
	mb.box("gun_tan", Vector3(0, 0.006, -0.07), Vector3(0.034, 0.03, 0.22))
	mb.box("gun_blk", Vector3(0, 0.042, -0.095), Vector3(0.037, 0.044, 0.31))
	mb.box("gun_blk", Vector3(0, 0.066, -0.095), Vector3(0.026, 0.006, 0.31))
	rail(mb, Vector3(0, 0.0715, -0.095), 0.3)
	for sgn: float in [-1.0, 1.0]:
		ribs(mb, "gun_poly", Vector3(sgn * 0.0188, 0.042, -0.2), Vector3(0.0012, 0.012, 0.02), 3, Vector3(0, 0, 0.03))
		mb.box("gun_steel", Vector3(sgn * 0.014, 0.05, 0.16), Vector3(0.006, 0.008, 0.2))
		screw(mb, Vector3(sgn * 0.0188, 0.03, -0.02))
		screw(mb, Vector3(sgn * 0.0188, 0.03, -0.16))
		screw(mb, Vector3(sgn * 0.0174, 0.004, 0.02))
	mb.box("gun_steel", Vector3(0.0188, 0.046, -0.075), Vector3(0.0012, 0.016, 0.05))
	mb.cyl("gun_blk", Vector3(0, 0.042, -0.27), 0.0085, 0.05, 2, 10)
	for i in 3:
		var pb := Basis(Vector3.BACK, float(i) * TAU / 3.0)
		mb.box("gun_steel", Vector3(0, 0.042, -0.305) + pb * Vector3(0, 0.009, 0), Vector3(0.006, 0.004, 0.03), pb)
	mb.box("gun_tan", Vector3(0, -0.012, -0.105), Vector3(0.03, 0.03, 0.05))
	mb.box("gun_tan", Vector3(0, -0.012, -0.2), Vector3(0.03, 0.012, 0.05))
	mb.box("gun_poly", Vector3(0, -0.045, -0.196), Vector3(0.026, 0.062, 0.03), Basis(Vector3.RIGHT, 0.22))
	ribs(mb, "gun_grip", Vector3(0, -0.046, -0.212), Vector3(0.022, 0.005, 0.003), 5, Vector3(0, 0.011, 0.0025))
	mb.cyl("gun_steel", Vector3(0, 0.05, 0.062), 0.008, 0.036, 0, 8)
	mb.box("gun_steel", Vector3(0, 0.02, 0.256), Vector3(0.034, 0.1, 0.012))
	mb.box("gun_rubber", Vector3(0, 0.02, 0.265), Vector3(0.036, 0.104, 0.008))
	reddot(mb, Vector3(0, 0.0735, -0.03))
	mb.box("gun_blk", Vector3(0, 0.078, -0.225), Vector3(0.016, 0.006, 0.03))
	mb.box("gun_steel", Vector3(-0.0178, 0.012, 0.0), Vector3(0.002, 0.005, 0.016), Basis(Vector3.RIGHT, 0.5))
	mb.box("gun_steel", Vector3(-0.02, 0.04, 0.05), Vector3(0.004, 0.016, 0.006))
	mark(root, Vector3(-0.0188, 0.046, -0.07), "STRYK-9", true, 34)
	mark(root, Vector3(0.0188, 0.03, -0.15), "CAL 9x19   SK 5521", false, 18)
	var ch: Node3D = part(root, Vector3(-0.022, 0.048, -0.13))
	var ck := Kit.new()
	ck.cyl("gun_steel", Vector3(-0.004, 0, 0), 0.006, 0.014, 0, 8)
	ck.box("gun_steel", Vector3(0.002, 0, 0), Vector3(0.004, 0.008, 0.02))
	ck.commit(ch, false)
	var mg: Node3D = part(root, Vector3(0, -0.02, -0.105))
	mg.rotation.x = 0.08
	var mk := Kit.new()
	mk.box("gun_steel", Vector3(0, -0.085, 0), Vector3(0.022, 0.17, 0.034))
	ribs(mk, "gun_blk", Vector3(0, -0.1, 0), Vector3(0.0235, 0.004, 0.035), 5, Vector3(0, 0.022, 0))
	mk.box("gun_poly", Vector3(0, -0.173, 0), Vector3(0.026, 0.01, 0.04))
	mk.cyl("gun_brass", Vector3(0, -0.001, -0.003), 0.0048, 0.024, 2, 8)
	mk.commit(mg, false)
	o["parts"] = {"bolt": ch, "mag": mg}
	o["magdir"] = Basis(Vector3.RIGHT, 0.08) * Vector3(0, -1, 0)
	o["muzzle"] = Vector3(0, 0.042, -0.325)
	o["sight"] = Vector3(0, 0.1035, 0)
	o["eject"] = Vector3(0.022, 0.05, -0.075)
